# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# Random secret used to sign session tokens.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Admin login credentials for the /admin dashboard.
ADMIN_EMAIL=admin@example.com

# bcrypt hash of the admin password — do NOT put a plain-text password here.
# Generate one with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
#
# IMPORTANT: bcrypt hashes contain literal `$` characters (e.g. $2b$10$...).
# Next.js's env loader treats $VAR as variable interpolation, so you must
# escape every $ as \$ in this file or the value will silently come out
# blank/wrong. Example:
#   ADMIN_PASSWORD_HASH=\$2b\$10\$abc123...
ADMIN_PASSWORD_HASH=
